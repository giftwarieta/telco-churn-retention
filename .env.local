# ChurnIQ local environment

# AI Consultant via Groq
# GROQ_API_KEY=
# GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# Optional: override the default Groq model
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional local Redis testing.
# On Vercel, prefer UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# The app also supports the telcom_churn_* and KV_* aliases below.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# telcom_churn_UPSTASH_REDIS_REST_URL=
# telcom_churn_UPSTASH_REDIS_REST_TOKEN=
# telcom_churn_KV_REST_API_URL=
# telcom_churn_KV_REST_API_TOKEN=

# Optional local backend override for development only.
# Leave unset to use the built-in Vercel-style Python function.
# NEXT_PUBLIC_API_URL=http://localhost:8000
