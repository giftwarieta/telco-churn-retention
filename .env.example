# Leave this unset on Vercel if you want the frontend to use the built-in Python backend at /api
NEXT_PUBLIC_API_URL=

# Required for the AI consultant
GROQ_API_KEY=
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Redis analytics store
# Preferred on Vercel / Upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional app-specific aliases:
telcom_churn_UPSTASH_REDIS_REST_URL=
telcom_churn_UPSTASH_REDIS_REST_TOKEN=

# Legacy KV-style aliases still supported:
telcom_churn_KV_REST_API_URL=
telcom_churn_KV_REST_API_TOKEN=

# Optional generic fallback names
KV_REST_API_URL=
KV_REST_API_TOKEN=
